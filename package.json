{
  "name": "poketokenpet",
  "version": "0.2.1",
  "description": "AI \ucf54\ub529 \ud1a0\ud070\uc73c\ub85c \uc790\ub77c\ub294 \ud3ec\ucf13\ubaac \u2014 Windows/macOS \ud2b8\ub808\uc774 \uc571",
  "author": "calia",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "validate": "node --experimental-strip-types --no-warnings scripts/validate.ts",
    "gen:species": "node --experimental-strip-types --no-warnings scripts/gen-species.ts",
    "gen:forms": "node --experimental-strip-types --no-warnings scripts/gen-forms.ts",
    "gen:moves": "node --experimental-strip-types --no-warnings scripts/gen-moves.ts",
    "gen:dex": "node --experimental-strip-types --no-warnings scripts/gen-dex.ts",
    "gen:grass": "node --experimental-strip-types --no-warnings scripts/gen-grass.ts",
    "gen:journey": "node --experimental-strip-types --no-warnings scripts/gen-journey.ts",
    "gen:legends": "node --experimental-strip-types --no-warnings scripts/gen-legends.ts",
    "gen:ui": "node --experimental-strip-types --no-warnings scripts/gen-ui.ts",
    "gen:shots": "node --experimental-strip-types --no-warnings scripts/gen-shots.ts",
    "test": "vitest run",
    "build:electron": "node scripts/build-electron.mjs",
    "electron:dev": "node scripts/dev-electron.mjs",
    "app:build": "npm run build && npm run build:electron",
    "app:pack": "npm run app:build && electron-builder --dir",
    "app:dist": "npm run app:build && electron-builder --publish never"
  },
  "dependencies": {
    "galmuri": "^2.40.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.11.6",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
